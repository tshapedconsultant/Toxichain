# Copy to .env and fill locally. Never commit .env or private keys.

# Shared / Hardhat
SEPOLIA_RPC_URL=
SEPOLIA_PRIVATE_KEY=
ATTESTER_ADDRESS=
ATTESTER_PRIVATE_KEY=

# Moderator service
PORT=3001
CHAIN_ID=31337
CONTRACT_ADDRESS=
TOXICITY_THRESHOLD=0.7
MODERATION_TIMEOUT_MS=1800
ATTESTATION_TTL_SECONDS=300
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Set to 1 only for local pipeline debugging. Production must run the TF.js layer.
SKIP_TOXICITY=0

# Frontend lives in frontend/.env (see frontend/.env.example). Do not put secrets there.
# VITE_CONTRACT_ADDRESS=
# VITE_MODERATOR_URL=http://127.0.0.1:3001
# VITE_CHAIN_ID=31337
